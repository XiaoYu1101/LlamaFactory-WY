# Copy this file to .env in the project root. Never commit real credentials.
# Local / LAN OpenAI-compatible model service. Include /v1 if your server uses it.
WY_INTENT_BASE_URL=http://127.0.0.1:8000/v1
# auto (or empty): discover the single model returned by GET /models.
# Multiple models: use the exact id returned by your service, not a guessed Qwen name.
WY_INTENT_MODEL=auto
# Leave empty for a local service without authentication.
WY_INTENT_API_KEY=
# These are optional. Plain JSON generation works without response_format support.
WY_INTENT_JSON_MODE=false
WY_INTENT_THINKING=null
WY_INTENT_TIMEOUT_SECONDS=60
WY_INTENT_MAX_TOKENS=8192
WY_INTENT_BATCH_SIZE=10
WY_INTENT_SEED_COUNT=3
